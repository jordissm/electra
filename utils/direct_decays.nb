f120415f076c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ImportMomentumSpectrumData", "[", "inputFile_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rawInput", ",", "newInput", ",", "error"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rawInput", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"path", ",", "inputFile"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Trim", " ", "headers"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"rawInput", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", "All"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Transpose", " ", "to", " ", "obtain", " ", "a", " ", "list", " ", "of",
        " ", "columns"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"Transpose", "@", "newInput"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"error", "=", 
      RowBox[{"newInput", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Re", "-", 
       RowBox[{"scale", " ", "second", " ", "column"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"newInput", "/.", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pT_", ",", "dNdpT_", ",", "error_"}], "}"}], ":>", 
        RowBox[{"{", 
         RowBox[{"pT", ",", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"2", "\[Pi]"}]], 
           FractionBox["1", "pT"], "dNdpT"}], ",", "error"}], "}"}]}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"newInput", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"newInput", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"newInput", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->CompressedData["
