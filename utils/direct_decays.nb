Cell[BoxData[
 RowBox[{
  RowBox[{"AddMomentumSpectra", "[", 
   RowBox[{"spectrum1_", ",", "spectrum2_", ",", "scale_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "totalSpectrum", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"totalSpectrum", "=", 
      RowBox[{"scale", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"spectrum1", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"spectrum2", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"spectrum1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "totalSpectrum"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.890398807742975*^9, 3.890398919718214*^9}, {
