Cell[BoxData[{
 RowBox[{
  RowBox[{"ImportMomentumSpectrumData", "[", "inputFile_", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rawInput", ",", "newInput", ",", "error"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rawInput", "=", 
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"path", ",", "inputFile"}], "}"}], "]"}], ",", 
        "\"\<Table\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Trim", " ", "headers"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"rawInput", "[", 
       RowBox[{"[", 
        RowBox[{"13", ";;", "All"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Transpose", " ", "to", " ", "obtain", " ", "a", " ", "list", " ", "of",
        " ", "columns"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"Transpose", "@", "newInput"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Re", "-", 
       RowBox[{"scale", " ", "second", " ", "column"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"newInput", "=", 
      RowBox[{"newInput", "/.", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "pTLow_", ",", "pTHigh_", ",", "sumw_", ",", "sumw2_", ",", "sumwx_",
           ",", "sumwx2_", ",", "dNdpT_"}], "}"}], ":>", 
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"pTLow", "+", "pTHigh"}], "2"], ",", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"2", "\[Pi]"}]], 
           FractionBox["1", 
            FractionBox[
             RowBox[{"pTLow", "+", "pTHigh"}], "2"]], "dNdpT"}]}], 
         "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"newInput", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"newInput", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
