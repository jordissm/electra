# Copy this file to slurm-scripts/cluster.env and edit it for your cluster.
# slurm-scripts/cluster.env is ignored by git so each user can keep local settings.
#
# Any setting here can still be overridden per submission with key=value args:
#   bash slurm-scripts/smash_submit.sh PARTITION=debug MEMORY=8G

# Core Slurm settings used by all submit scripts.
ACCOUNT=qgp
PARTITION=qgp
JOB_NAME_PREFIX=electra

# Default resources. Script-specific values below override these when set.
DEFAULT_TIME_LIMIT=12:00:00
DEFAULT_CPUS_PER_TASK=1
DEFAULT_MEMORY=2G

# Script-specific walltime defaults.
EHIJING_TIME_LIMIT=00:30:00
EHIJING_POST_TIME_LIMIT=00:30:00
SMASH_TIME_LIMIT=12:00:00
ANALYSIS_TIME_LIMIT=12:00:00
INDEX_TIME_LIMIT=00:30:00

# Lightweight helper-job resources.
EHIJING_POST_MEMORY=1G
INDEX_MEMORY=1G

# Common project/runtime paths. Uncomment and edit if your cluster needs them.
# PROJECT_ROOT=/path/to/electra
# OUTPUT_HOST=${PROJECT_ROOT}/output
# OUTPUT_CONT=/workspace/output
# IMG=/scratch/${USER}/containers/electra.sif
